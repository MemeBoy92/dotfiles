# ==========================================
# Ghostty Configuration
# ==========================================

# Shell
command = /bin/zsh

# Font (Powerlevel10k & Nerd Fonts support)
font-family = "MesloLGS NF"
font-size = 13.5

# Theme & Colors
theme = Catppuccin Mocha

# Window & AeroSpace Tiling Compatibility
macos-titlebar-style = hidden
window-padding-x = 12
window-padding-y = 12
window-padding-color = background

# Option key as Alt (essential for Zsh / Tmux / Emacs / Neovim)
macos-option-as-alt = true

# Cursor
cursor-style = block
cursor-style-blink = false

# Integration & Behaviors
copy-on-select = clipboard
confirm-close-surface = false
quit-after-last-window-closed = true
initial-window = true
shell-integration = zsh

# Global Drop-Down Quick Terminal (Overlay Mode)
keybind = global:super+ctrl+alt+shift+backquote=toggle_quick_terminal

quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-animation-duration = 0.12
quick-terminal-space-behavior = move
quick-terminal-autohide = true

# Ghosty / Translucent Glassmorphism Aesthetics
background-opacity = 0.88
background-blur-radius = 20
