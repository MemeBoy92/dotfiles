# ==============================================================================
# Sway Configuration (Wayland)
# Optimized for ThinkPad T14s Gen 2 & Catppuccin Mocha aesthetic
# Preserves 100% keybinding and workspace symmetry with macOS (AeroSpace) & i3wm
# ==============================================================================

# Modifier key (Mod4 = Super / Windows key)
set $mod Mod4

# Font for window titles and bar
font pango: MesloLGS NF, Noto Sans Regular 10

# Default layout
workspace_layout default

# Focus follows mouse (matches macOS AutoRaise behavior)
focus_follows_mouse yes

# Window borders & Gaps (matching macOS JankyBorders & AeroSpace: 4px border, 10px gaps)
default_border pixel 4
default_floating_border pixel 4
gaps inner 10
gaps outer 10

# Drag floating windows with $mod + Left Click
floating_modifier $mod

# Workspace auto back-and-forth
workspace_auto_back_and_forth yes
bindsym $mod+Tab workspace back_and_forth
bindsym Control+Mod1+Tab workspace back_and_forth
bindsym $mod+Shift+Tab workspace prev

# ==============================================================================
# Hardware / Input Configuration (ThinkPad T14s Gen 2)
# ==============================================================================

# Touchpad configuration with natural scrolling, tap-to-click, and palm rejection
input "type:touchpad" {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
    accel_profile "adaptive"
}

# Keyboard configuration
input "type:keyboard" {
    xkb_layout "us"
}

# TrackPoint configuration
input "type:pointer" {
    accel_profile "adaptive"
}

# ==============================================================================
# Output / Display Configuration
# ==============================================================================

# Catppuccin wallpaper (falls back to solid mantle if image not present)
output * bg /home/jakem/Pictures/wallpapers/catppuccin-shaded-landscape.png fill #181825

# ==============================================================================
# Workspaces
# ==============================================================================

set $ws1 "1:"
set $ws2 "2:"
set $ws3 "3:"
set $ws4 "4:"
set $ws5 "5:"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Switch to workspace ($mod + 1..0)
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

# Move focused container to workspace ($mod + Shift + 1..0)
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

# AeroSpace dual bindings for workspace switching (Ctrl + Alt + 1..9)
bindsym Control+Mod1+1 workspace $ws1
bindsym Control+Mod1+2 workspace $ws2
bindsym Control+Mod1+3 workspace $ws3
bindsym Control+Mod1+4 workspace $ws4
bindsym Control+Mod1+5 workspace $ws5
bindsym Control+Mod1+6 workspace $ws6
bindsym Control+Mod1+7 workspace $ws7
bindsym Control+Mod1+8 workspace $ws8
bindsym Control+Mod1+9 workspace $ws9

# AeroSpace dual bindings for moving container to workspace (Ctrl + Alt + Shift + 1..9)
bindsym Control+Mod1+Shift+1 move container to workspace $ws1
bindsym Control+Mod1+Shift+2 move container to workspace $ws2
bindsym Control+Mod1+Shift+3 move container to workspace $ws3
bindsym Control+Mod1+Shift+4 move container to workspace $ws4
bindsym Control+Mod1+Shift+5 move container to workspace $ws5
bindsym Control+Mod1+Shift+6 move container to workspace $ws6
bindsym Control+Mod1+Shift+7 move container to workspace $ws7
bindsym Control+Mod1+Shift+8 move container to workspace $ws8
bindsym Control+Mod1+Shift+9 move container to workspace $ws9

# ==============================================================================
# Keybindings: Core Actions
# ==============================================================================

# Start Terminal (Ghostty)
bindsym $mod+Return exec ghostty
bindsym Control+Mod1+Return exec ghostty

# Kill focused window
bindsym $mod+q kill
bindsym Control+Mod1+w kill

# Reload configuration
bindsym $mod+Shift+c reload

# Exit Sway (session logout prompt)
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit Sway?' -B 'Yes, exit sway' 'swaymsg exit'
bindsym Control+Mod1+Shift+r reload

# Lock screen (Catppuccin Mocha lock)
bindsym $mod+Control+l exec swaylock -f -c 1e1e2e
bindsym $mod+Shift+x exec swaylock -f -c 1e1e2e

# App Launcher & Switchers (Rofi Wayland)
bindsym $mod+d exec rofi -show drun
bindsym $mod+t exec rofi -show window
bindsym $mod+c exec "cliphist list | rofi -dmenu -p 'Clipboard' | cliphist decode | wl-copy"

# Quick Application Launches
bindsym $mod+w exec firefox
bindsym $mod+n exec thunar

# ==============================================================================
# Navigation & Window Management (IJKL layout matching AeroSpace)
# ==============================================================================

# Focus navigation (IJKL)
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+i focus up
bindsym $mod+l focus right

# Focus navigation (AeroSpace Ctrl+Alt IJKL)
bindsym Control+Mod1+j focus left
bindsym Control+Mod1+k focus down
bindsym Control+Mod1+i focus up
bindsym Control+Mod1+l focus right

# Arrow keys fallback
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused window (IJKL)
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+i move up
bindsym $mod+Shift+l move right

# Move focused window (AeroSpace Ctrl+Alt+Shift IJKL)
bindsym Control+Mod1+Shift+j move left
bindsym Control+Mod1+Shift+k move down
bindsym Control+Mod1+Shift+i move up
bindsym Control+Mod1+Shift+l move right

# Move window arrow keys fallback
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Monitor focus & container movement (matching AeroSpace)
bindsym Control+Mod1+n focus output next
bindsym Control+Mod1+Shift+n move container to output next

# Quick resize shortcuts (matching AeroSpace)
bindsym Control+Mod1+minus resize shrink width 50 px or 5 ppt; resize shrink height 50 px or 5 ppt
bindsym Control+Mod1+equal resize grow width 50 px or 5 ppt; resize grow height 50 px or 5 ppt
bindsym $mod+minus resize shrink width 50 px or 5 ppt; resize shrink height 50 px or 5 ppt
bindsym $mod+equal resize grow width 50 px or 5 ppt; resize grow height 50 px or 5 ppt

# Layout & Splitting
bindsym $mod+h splith
bindsym $mod+v splitv
bindsym $mod+e layout toggle split
bindsym Control+Mod1+slash layout toggle split
bindsym $mod+s layout stacking
bindsym $mod+g layout tabbed
bindsym Control+Mod1+comma layout tabbed

# Fullscreen & Floating
bindsym $mod+f fullscreen toggle
bindsym Control+Mod1+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym Control+Mod1+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# ==============================================================================
# Hardware Multimedia Keys (ThinkPad T14s)
# ==============================================================================

# Backlight control (brightnessctl)
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# Audio volume control (Wireplumber / Pipewire with pactl fallback)
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+ || pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- || pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle || pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle || pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Audio media playback (playerctl)
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# Screenshots (grim + slurp)
bindsym Print exec mkdir -p ~/Pictures/Screenshots && grim ~/Pictures/Screenshots/$(date +'%Y-%m-%d-%H%M%S_screenshot.png') && notify-send "Screenshot Captured" "Saved to ~/Pictures/Screenshots/"
bindsym $mod+Shift+Print exec mkdir -p ~/Pictures/Screenshots && grim -g "$(slurp)" ~/Pictures/Screenshots/$(date +'%Y-%m-%d-%H%M%S_screenshot.png') && notify-send "Area Screenshot Captured" "Saved to ~/Pictures/Screenshots/"
bindsym $mod+Print exec grim -g "$(slurp)" - | wl-copy && notify-send "Screenshot Copied" "Copied selected area to clipboard."

# ==============================================================================
# Window Rules & Workspaces
# ==============================================================================

# Default workspace assignments (supporting Wayland app_id and XWayland class)
assign [app_id="(?i)ghostty"] $ws1
assign [class="(?i)ghostty"] $ws1
assign [app_id="(?i)firefox"] $ws2
assign [class="(?i)firefox"] $ws2
assign [app_id="thunar"] $ws3
assign [class="Thunar"] $ws3
assign [app_id="thunderbird"] $ws4
assign [class="Thunderbird"] $ws4
assign [app_id="TelegramDesktop"] $ws5
assign [class="TelegramDesktop"] $ws5

# Floating dialogs
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_role="Preferences"] floating enable
for_window [window_role="About"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable
for_window [app_id="pavucontrol"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [app_id="blueberry.py"] floating enable
for_window [class="Blueberry.py"] floating enable
for_window [app_id="nm-connection-editor"] floating enable
for_window [class="nm-connection-editor"] floating enable
for_window [app_id="galculator"] floating enable
for_window [class="Galculator"] floating enable

# Inhibit idle when full screen (e.g. video playback)
for_window [app_id=".*"] inhibit_idle fullscreen
for_window [class=".*"] inhibit_idle fullscreen

# ==============================================================================
# Catppuccin Mocha Color Theme
# ==============================================================================

set $rosewater #f5e0dc
set $flamingo  #f2cdcd
set $pink      #f5c2e7
set $mauve     #cba6f7
set $red       #f38ba8
set $maroon    #eba0ac
set $peach     #fab387
set $yellow    #f9e2af
set $green     #a6e3a1
set $teal      #94e2d5
set $sky       #89dceb
set $sapphire  #74c7ec
set $blue      #89b4fa
set $lavender  #b4befe
set $text      #cdd6f4
set $subtext1  #bac2de
set $subtext0  #a6adc8
set $overlay2  #9399b2
set $overlay1  #7f849c
set $overlay0  #6c7086
set $surface2  #585b70
set $surface1  #45475a
set $surface0  #313244
set $base      #1e1e2e
set $mantle    #181825
set $crust     #11111b

# Window Border Styling (matching macOS JankyBorders)
# class                  border      bground     text        indicator   child_border
client.focused           $blue       $mantle     $text       $mauve      $blue
client.unfocused         $surface0   $mantle     $overlay0   $surface0   $surface0
client.focused_inactive  $surface0   $mantle     $overlay0   $surface0   $surface0
client.urgent            $red        $mantle     $text       $red        $red
client.placeholder       $crust      $crust      $text       $crust      $crust
client.background        $base

# ==============================================================================
# Status Bar (Waybar)
# ==============================================================================

bar {
    swaybar_command waybar
}

# ==============================================================================
# Autostart Services
# ==============================================================================

# Polkit authentication agent
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# Notification daemon (Dunst with native Wayland support)
exec dunst

# Clipboard history daemon (wl-paste + cliphist)
exec wl-paste --watch cliphist store
exec wl-paste --type image --watch cliphist store

# Idle and Screen Locker management
exec swayidle -w \
    timeout 300 'swaylock -f -c 1e1e2e' \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f -c 1e1e2e'
