/*******************************************************
 * ROFI Catppuccin Mocha Theme
 *******************************************************/
* {
    bg-col:  #1e1e2e;
    bg-col-light: #313244;
    border-col: #89b4fa;
    selected-col: #313244;
    blue: #89b4fa;
    mauve: #cba6f7;
    fg-col: #cdd6f4;
    fg-col2: #f38ba8;
    grey: #6c7086;

    width: 600;
    font: "MesloLGS NF 12";

    background-color: transparent;
    text-color: @fg-col;
    margin: 0;
    padding: 0;
}

window {
    background-color: @bg-col;
    border: 2px;
    border-color: @border-col;
    border-radius: 12px;
    padding: 10px;
}

mainbox {
    background-color: @bg-col;
}

inputbar {
    children: [prompt,entry];
    background-color: @bg-col-light;
    border-radius: 8px;
    padding: 6px 10px;
    margin: 4px 4px 10px 4px;
}

prompt {
    background-color: @blue;
    padding: 4px 8px;
    text-color: @bg-col;
    border-radius: 6px;
    margin: 0px 8px 0px 0px;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    padding: 4px;
    margin: 0px 0px 0px 0px;
    text-color: @fg-col;
    background-color: transparent;
}

listview {
    border: 0px;
    padding: 4px;
    margin: 0px 0px 0px 0px;
    columns: 1;
    lines: 8;
    background-color: @bg-col;
}

element {
    padding: 8px;
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 6px;
}

element-icon {
    size: 24px;
    padding: 0 8px 0 0;
}

element selected {
    background-color:  @selected-col;
    text-color: @blue;
}

mode-switcher {
    spacing: 0;
}

button {
    padding: 6px;
    background-color: @bg-col-light;
    text-color: @grey;
    vertical-align: 0.5; 
    horizontal-align: 0.5;
}

button selected {
  background-color: @bg-col;
  text-color: @blue;
}

message {
    background-color: @bg-col-light;
    margin: 2px;
    padding: 2px;
    border-radius: 5px;
}

textbox {
    padding: 6px;
    margin: 8px 0px 0px 10px;
    text-color: @blue;
    background-color: @bg-col-light;
}
