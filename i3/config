# Start i3bar at the top matching Sketchybar
bar {
        font pango: MesloLGS NF, Noto Sans Regular 10
        status_command i3blocks -c ~/.config/i3/i3blocks.conf
        position top
        tray_padding 2
        strip_workspace_numbers yes

        colors {
            separator          $surface1
            background         $mantle
            statusline         $text
#                           border              bg          txt         indicator
            focused_workspace   $blue           $blue       $mantle     $mauve
            active_workspace    $surface0       $surface0   $text       $mauve
            inactive_workspace  $mantle         $mantle     $overlay0   $mantle
            urgent_workspace    $red            $red        $mantle     $red
        }
}

