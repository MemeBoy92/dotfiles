#!/usr/bin/env bash

# Power profile status for i3blocks (supports both power-profiles-daemon and tlp)

# 1. Check if power-profiles-daemon is active
if command -v powerprofilesctl >/dev/null 2>&1 && systemctl is-active --quiet power-profiles-daemon 2>/dev/null; then
  current_profile=$(/usr/bin/powerprofilesctl get 2>/dev/null)
  declare -A tags=(
    [performance]="Performance"
    [balanced]="Balanced"
    [power-saver]="Power saver"
  )
  profile_tag=${tags[$current_profile]}
  echo "${profile_tag:-$current_profile}"
  exit 0
fi

# 2. Check if TLP is active
if systemctl is-active --quiet tlp 2>/dev/null; then
  if [[ -f /sys/class/power_supply/AC/online ]] && [[ $(cat /sys/class/power_supply/AC/online) -eq 1 ]]; then
    echo "TLP: AC"
  else
    echo "TLP: BAT"
  fi
  exit 0
fi

echo ""
